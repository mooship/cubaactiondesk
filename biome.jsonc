{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
  },
  "files": {
    "includes": [
      "**",
      "!**/.claude",
      "!**/.playwright-mcp",
      // Generated by scripts/build-*.ts and drizzle-kit, with tests that fail if they drift.
      "!public",
      "!workers/link-checker/links.generated.json",
      "!migrations",
      // Prose: the content check validates it, and a formatter must not rewrap it.
      "!src/content",
      "!docs",
    ],
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
    },
  },
  "css": {
    "parser": { "cssModules": true },
    "formatter": { "enabled": true },
  },
  "json": {
    "formatter": { "enabled": true },
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "whitespaceSensitivity": "css",
    },
  },
  "markdown": {
    "formatter": { "enabled": false },
  },
  "yaml": {
    "formatter": { "enabled": false },
  },
  "overrides": [
    {
      // Biome's Astro formatter is experimental and changes rendered text under compressHTML: it joins
      // "{SITE.name} is" into "SAis" and pads link text with spaces. Lint .astro, but do not format it.
      // Import order is the CSS cascade order in a component (tokens.css before base.css before the modules),
      // so the import sorter stays off here too.
      "includes": ["**/*.astro"],
      "formatter": { "enabled": false },
      "assist": { "actions": { "source": { "organizeImports": "off" } } },
    },
    {
      // Keep the trailing commas Prettier wrote; wrangler accepts them.
      "includes": ["**/*.jsonc"],
      "json": { "formatter": { "trailingCommas": "all" } },
    },
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Beyond the recommended set: the Unicorn and accessibility rules the old ESLint config enforced that map
      // onto a Biome rule.
      "a11y": {
        "noNoninteractiveElementInteractions": "error",
        "noStaticElementInteractions": "error",
        "useFocusableInteractive": "error",
        "useKeyWithMouseEvents": "error",
      },
      "complexity": {
        "noForEach": "error",
        "noUselessUndefined": "error",
        "useArrayFind": "error",
        "useArraySome": "error",
        "useDateNow": "error",
        "useIndexOf": "error",
        "useRegexpTest": "error",
      },
      "correctness": {
        "noGlobalDirnameFilename": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
      },
      "performance": {
        "useDomNodeTextContent": "error",
      },
      "style": {
        // TypeScript's strict mode already guards these, and typescript-eslint's recommended set allowed them.
        "noNonNullAssertion": "off",
        "noCommonJs": "error",
        "useArrayLiterals": "error",
        "useAtIndex": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useConst": "error",
        "useDomQuerySelector": "error",
        "useExplicitLengthCheck": "error",
        "useForOf": "error",
        "useGlobalThis": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useThrowNewError": "error",
        "useTrimStartEnd": "error",
      },
      "suspicious": {
        "noDocumentCookie": "error",
        "useErrorMessage": "error",
        "useIsArray": "error",
      },
    },
  },
}
