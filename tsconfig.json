{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "worker-configuration.d.ts",
    "src/**/*",
    "workers/**/*",
    "tests/**/*",
    "scripts/**/*",
    "*.config.ts"
  ],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
