{
  "name": "cubaactiondesk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Cuba Action Desk SA: act, learn and give, for South Africans who want to do something about the US blockade of Cuba.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "lint": "npm exec --prefix tools/lint -- eslint --max-warnings 0 .",
    "lint:fix": "npm exec --prefix tools/lint -- eslint --fix .",
    "lint:setup": "npm ci --prefix tools/lint",
    "lint:ensure": "node scripts/ensure-lint.mjs",
    "lint:ci": "npm run lint:setup && npm run format:check && npm run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:content": "node scripts/check-content.ts",
    "check:budgets": "node scripts/check-budgets.ts",
    "check:output": "node scripts/check-output.ts",
    "check:html": "html-validate dist/client",
    "db:generate": "drizzle-kit generate",
    "deploy": "npm run check:content && npx wrangler d1 migrations apply DB --remote && npm run build && npx wrangler deploy",
    "build:icons": "node scripts/build-icons.mjs",
    "build:headers": "node scripts/build-headers.ts",
    "build:links": "node scripts/build-link-list.ts",
    "build:images": "node scripts/build-images.ts",
    "build:avatars": "node scripts/build-profile-pictures.ts",
    "lhci": "lhci autorun --config=.github/lighthouserc.cjs",
    "prepare": "lefthook install --force || echo \"Skipped git hooks (not a git repository)\"",
    "lhci:desktop": "lhci autorun --config=.github/lighthouserc.desktop.cjs"
  },
  "prettier": {
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.3",
    "@astrojs/markdown-satteri": "0.4.6",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "astro": "7.4.4",
    "drizzle-orm": "0.45.4",
    "satteri": "0.10.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "html-validate": "11.17.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.155.0",
    "yaml": "2.9.1"
  }
}
