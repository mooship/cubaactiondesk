{
  "name": "cubaactiondesk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Cuba Action Desk SA: act, learn and give, for South Africans who want to do something about the US blockade of Cuba.",
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "preview": "astro preview",
    "types": "cf workers types",
    "typecheck": "astro sync && tsc --noEmit --runExternalCode",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci --error-on-warnings .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:content": "node scripts/check-content.ts",
    "check:budgets": "node scripts/check-budgets.ts",
    "check:output": "node scripts/check-output.ts",
    "check:html": "html-validate .cloudflare/output/v1/workers/default/assets",
    "db:generate": "drizzle-kit generate",
    "deploy": "npm run check:content && npm run deploy:ci",
    "deploy:ci": "cf d1 migrations apply 5ae35ef9-3db5-4260-b1fa-3a7021e2b507 --dir migrations && cf deploy",
    "d1:migrate:e2e": "cf d1 migrations apply 0b6f3d52-8d2e-4f6a-9a41-3c5e7d1f2a90 --local --mode e2e --dir migrations",
    "build:e2e": "astro build --mode e2e",
    "build:icons": "node scripts/build-icons.mjs",
    "build:headers": "node scripts/build-headers.ts",
    "build:images": "node scripts/build-images.ts",
    "build:avatars": "node scripts/build-profile-pictures.ts",
    "lhci": "lhci autorun --config=.github/lighthouserc.cjs",
    "prepare": "lefthook install --force || echo \"Skipped git hooks (not a git repository)\"",
    "lhci:desktop": "lhci autorun --config=.github/lighthouserc.desktop.cjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "15.0.0-beta.6",
    "@astrojs/markdown-satteri": "0.4.8",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.10",
    "drizzle-orm": "0.45.4",
    "satteri": "0.11.7"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@cloudflare/vite-plugin": "2.0.0-rc.2",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "cf": "1.0.0-rc.2",
    "drizzle-kit": "0.31.11",
    "html-validate": "11.21.0",
    "lefthook": "2.2.2",
    "sharp": "0.35.5",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
