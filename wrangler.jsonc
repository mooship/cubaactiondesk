{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cubaactiondesk",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs first only where it has work to do: the server-rendered routes
    // (/api, /go, /act, /give) and the pages that negotiate Markdown (/learn/*, /act/*,
    // /give). Everything else, including the .md twins, is served straight from static
    // assets with no Worker CPU. A path missing from this list gets the static 404 page.
    "run_worker_first": ["/api/*", "/go/*", "/act", "/act/*", "/give", "/learn/*", "!/learn/*.md", "!/act/*.md"],
  },
  // Moving to cubaactiondesk.org.za later means changing this pattern and SITE_URL in src/lib/site.ts.
  "routes": [{ "pattern": "cuba.timothybrits.co.za", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cubaactiondesk",
      "database_id": "5ae35ef9-3db5-4260-b1fa-3a7021e2b507",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "COUNTER_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "cuba_action_desk_events" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Kept true on purpose: the no-JavaScript Action Desk puts the sender's name and town in the query string, and
    // the privacy notice promises we never see them. Do not turn this off without changing that notice.
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issue_detection": {
      "enabled": true,
    },
  },
}
