{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cubaactiondesk",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs first only where it has work to do: the server-rendered routes
    // (/api, /go, /act, /give) and the pages that negotiate Markdown (/learn/*, /act/*,
    // /give). Everything else, including the .md twins, is served straight from static
    // assets with no Worker CPU. A path missing from this list gets the static 404 page.
    "run_worker_first": ["/api/*", "/go/*", "/act", "/act/*", "/give", "/learn/*", "!/learn/*.md", "!/act/*.md"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cubaactiondesk",
      // Replaced with the real id after `wrangler d1 create` (see docs/LAUNCH-CHECKLIST.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "COUNTER_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "cuba_action_desk_events" }],
  "observability": { "enabled": true },
}
