---
import Base from "../layouts/Base.astro";
import ActionCard from "../components/ActionCard.astro";
import prose from "../styles/prose.module.css";
import home from "../styles/home.module.css";
import { getLiveActions, getTargets, targetName } from "../lib/content.ts";
import { SITE } from "../lib/site.ts";

const actions = await getLiveActions();
const featured = actions[0];
const targets = await getTargets();

const entries = [
  {
    href: "/act",
    title: "Write to someone",
    text: "Choose a recipient and edit a suggested message. You send it from your own app.",
  },
  {
    href: "/learn",
    title: "Understand the blockade",
    text: "Read about the sanctions, their effects and South Africa's ties with Cuba. Follow the sources and the arguments for keeping them.",
  },
  {
    href: "/give",
    title: "Help fund aid",
    text: "Find an organisation delivering aid to Cuba. Read our checks before donating on its own website.",
  },
];
---

<Base description={SITE.tagline} path="/">
  <h1 class={home.title}>Take action on the US blockade of Cuba</h1>
  <p class={prose.lede}>
    From South Africa, you can write to a public representative or help fund aid to Cuba. Start with a message below, or
    read up on the blockade before deciding what to do.
  </p>

  <div class={home.paths}>
    {featured && (
      <section class={home.featured} aria-labelledby="featured-heading">
        <h2 id="featured-heading">A message you can send today</h2>
        <ActionCard
          slug={featured.id}
          title={featured.data.title}
          summary={featured.data.summary}
          timeMinutes={featured.data.timeMinutes}
          targetName={targetName(targets, featured.data.target)}
        />
      </section>
    )}

    <ul class={home.routes}>
      {entries.map((e) => (
        <li class={home.entry}>
          <h2 class={prose.cardTitle}>
            <a href={e.href}>{e.title}</a>
          </h2>
          <p>{e.text}</p>
        </li>
      ))}
    </ul>
  </div>

  <p class={prose.meta}>
    An independent South African project. <a href="/about">About the site</a>.
  </p>
</Base>

<script>
  import "../scripts/done-stars.ts";
</script>
