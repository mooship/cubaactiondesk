---
import Base from "../layouts/Base.astro";
import prose from "../styles/prose.module.css";
---

<Base title="Page not found" description="That page does not exist. Try Act, Learn or Give." noindex>
  <article class={prose.article}>
    <h1>We could not find that page</h1>
    <p class={prose.lede}>The link may be old, or mistyped.</p>
    <ul>
      <li>
        <a href="/act">Take action</a>
      </li>
      <li>
        <a href="/learn">Learn about the blockade</a>
      </li>
      <li>
        <a href="/give">Give</a>
      </li>
      <li>
        <a href="/">Go to the home page</a>
      </li>
    </ul>
  </article>
</Base>
