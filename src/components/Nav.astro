---
import styles from "./Nav.module.css";
import { NAV_ITEMS, isCurrent } from "../lib/site.ts";

const pathname = Astro.url.pathname;
---

<nav class={styles.nav} aria-label="Main">
  <ul class={styles.list}>
    {NAV_ITEMS.map((item) => (
      <li class={styles.item}>
        <a class={styles.link} href={item.href} aria-current={isCurrent(pathname, item.href) ? "page" : undefined}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
