---
import styles from "./Nav.module.css";
import { NAV_ITEMS, isCurrent, type NavIcon } from "../lib/site.ts";

const pathname = Astro.url.pathname;

// 24x24 stroke icons. They use currentColor so forced-colors mode keeps them visible.
const ICONS: Record<NavIcon, string> = {
  act: "M3 11 21 3l-8 18-2-8-8-2Z",
  learn: "M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5ZM19 19v2H6",
  give: "M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6C19 16.5 12 21 12 21Z",
  about: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM12 11v5M12 8h.01",
};
---

<nav class={styles.nav} aria-label="Main">
  <ul class={styles.list}>
    {NAV_ITEMS.map((item) => (
      <li class={styles.item}>
        <a class={styles.link} href={item.href} aria-current={isCurrent(pathname, item.href) ? "page" : undefined}>
          <svg
            class={styles.icon}
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d={ICONS[item.icon]} />
          </svg>
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
