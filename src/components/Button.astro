---
import styles from "./Button.module.css";

interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  /** Adds rel="noopener noreferrer" for links that leave the site. */
  external?: boolean;
  type?: "button" | "submit";
  disabled?: boolean;
  [attr: string]: unknown;
}

const { href, variant = "primary", external = false, type = "button", disabled = false, ...rest } = Astro.props;
---

{href && !disabled ? (
  <a
    class={styles.button}
    data-variant={variant}
    href={href}
    rel={external ? "noopener noreferrer" : undefined}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button class={styles.button} data-variant={variant} type={type} disabled={disabled} {...rest}>
    <slot />
  </button>
)}
