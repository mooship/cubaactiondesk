---
import styles from "./Logo.module.css";
import { SITE, STAR_PATH } from "../lib/site.ts";
---

<a class={styles.logo} href="/" aria-label={`${SITE.name}, home`}>
  <svg class={styles.mark} viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
    <circle cx="16" cy="16" r="16" class={styles.disc}></circle>
    <path class={styles.star} d={STAR_PATH}></path>
  </svg>
  <span class={styles.word}>
    {SITE.shortName}
    <span class={styles.sa}> SA</span>
  </span>
</a>
